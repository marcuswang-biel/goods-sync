{
	"name": "@goods/native",
	"version": "0.1.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"dev": "expo start --clear",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"bundle": "expo export --platform ios --platform android --output-dir dist",
		"check": "run-s -c check:*",
		"check:fmt": "pnpm --dir ../.. exec oxfmt --check apps/native",
		"check:lint": "pnpm --dir ../.. exec oxlint apps/native",
		"check:types": "tsc --noEmit",
		"check-types": "tsc --noEmit",
		"fmt": "pnpm --dir ../.. exec oxfmt --write apps/native",
		"lint": "pnpm --dir ../.. exec oxlint apps/native",
		"test": "vitest run"
	},
	"dependencies": {
		"@better-auth/core": "catalog:",
		"@better-auth/expo": "catalog:",
		"@convex-dev/better-auth": "catalog:",
		"@expo/log-box": "~56.0.14",
		"@expo/metro-runtime": "~56.0.21",
		"@goods/backend": "workspace:*",
		"@goods/domain": "workspace:*",
		"@goods/shared": "workspace:*",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"better-auth": "catalog:",
		"convex": "catalog:",
		"effect": "catalog:",
		"expo": "~56.0.23",
		"expo-constants": "~56.0.27",
		"expo-linking": "~56.0.18",
		"expo-network": "~56.0.5",
		"expo-router": "~56.2.21",
		"expo-secure-store": "~56.0.4",
		"expo-status-bar": "~56.0.4",
		"expo-web-browser": "~56.0.6",
		"react": "catalog:",
		"react-native": "0.85.3",
		"react-native-reanimated": "4.3.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-worklets": "0.8.3"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"npm-run-all2": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
