{
	"extends": "@goods/config/tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"jsx": "react-jsx",
		"types": ["vite/client", "vitest/globals"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"vitest.config.ts",
		"lingui.config.ts"
	],
	"exclude": ["node_modules"]
}
