{
	"name": "@goods/domain",
	"version": "0.0.1",
	"private": true,
	"description": "Business rules written in Effect. Pure TypeScript: never imports convex.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./offline": "./src/offline/index.ts",
		"./purchase": "./src/purchase/index.ts",
		"./stock": "./src/stock/index.ts"
	},
	"scripts": {
		"check": "run-s -c check:*",
		"check:lint": "oxlint .",
		"check:fmt": "oxfmt --check .",
		"check:types": "tsc --noEmit",
		"check-types": "tsc --noEmit",
		"lint": "oxlint .",
		"fmt": "oxfmt --write .",
		"test": "vitest run"
	},
	"dependencies": {
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@goods/config": "workspace:*",
		"npm-run-all2": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
