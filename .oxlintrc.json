{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"**/coverage/**",
		"**/routeTree.gen.ts",
		"**/convex/_generated/**",
		"**/.expo/**"
	],
	"options": {
		"typeAware": true
	},
	"jsPlugins": [
		"eslint-plugin-app-lingui",
		{
			"name": "anti-slop",
			"specifier": "./tools/oxlint/anti-slop/index.ts"
		}
	],
	"plugins": ["eslint", "oxc", "react", "unicorn", "typescript", "import"],
	"categories": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": [
			"error",
			{
				"ownedModulePrefixes": ["./", "../", "@/", "@acme/"]
			}
		],
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"react-in-jsx-scope": "off",
		"react/jsx-no-constructed-context-values": "off",
		"eslint/no-shadow": "off",
		"eslint/no-await-in-loop": "off",
		"oxc/no-map-spread": "off",
		"import/no-cycle": "error",
		"import/no-self-import": "error",
		"import/no-duplicates": "error",
		"import/no-unassigned-import": "off",
		"typescript/no-deprecated": "warn",
		"typescript/no-unsafe-type-assertion": "off",
		"typescript/consistent-return": "off",
		"typescript/no-floating-promises": "off",
		"typescript/no-unnecessary-type-arguments": "off",
		"typescript/no-unnecessary-type-assertion": "off",
		"typescript/no-unnecessary-template-expression": "off",
		"typescript/no-unnecessary-boolean-literal-compare": "off",
		"typescript/no-base-to-string": "off",
		"typescript/restrict-template-expressions": "off",
		"typescript/require-array-sort-compare": "off",
		"unicorn/no-nested-ternary": "off",
		"app-lingui/no-i18n-underscore-msg": "error",
		"app-lingui/no-i18n-underscore-in-tsx": "error",
		"app-lingui/no-module-scope-t": "error",
		"app-lingui/no-t-macro-parameter": "error",
		"eslint/no-restricted-imports": [
			"error",
			{
				"patterns": [
					{
						"group": ["**/_generated/server"],
						"importNames": ["mutation", "internalMutation"],
						"message": "Define mutations from convex/functions.ts so the database triggers stay attached."
					}
				]
			}
		],
		"eslint/no-underscore-dangle": [
			"warn",
			{
				"allow": ["_id", "_creationTime", "_tag", "_args"]
			}
		],
		"react/style-prop-object": [
			"warn",
			{
				"allow": ["StatusBar"]
			}
		]
	},
	"overrides": [
		{
			"files": ["**/convex/functions.ts"],
			"rules": {
				"eslint/no-restricted-imports": "off"
			}
		}
	]
}
